{
  "name": "multi-search-plus",
  "version": "2.2.0",
  "engines": [
    {"name": "Baidu", "url": "https://www.baidu.com/s?wd={keyword}", "region": "cn", "parser": "baidu", "note": "中文索引最全，Baidu有反爬验证"},
    {"name": "Bing CN", "url": "https://cn.bing.com/search?q={keyword}&ensearch=0", "region": "cn", "parser": "bing", "note": "必应中国版，中文结果首选"},
    {"name": "Bing INT", "url": "https://cn.bing.com/search?q={keyword}&ensearch=1", "region": "cn", "parser": "bing", "note": "必应国际版，英文结果走中国服务器"},
    {"name": "360", "url": "https://www.so.com/s?q={keyword}", "region": "cn", "parser": "generic_h3_p", "note": "360搜索，安全防护内置"},
    {"name": "Sogou", "url": "https://www.sogou.com/web?query={keyword}", "region": "cn", "parser": "generic_h3_p", "note": "搜狗网页，知乎内容优化好"},
    {"name": "WeChat", "url": "https://wx.sogou.com/weixin?type=2&query={keyword}", "region": "cn", "parser": "sogou_wechat", "note": "微信公众号搜索唯一渠道"},
    {"name": "Toutiao", "url": "https://so.toutiao.com/search?keyword={keyword}", "region": "cn", "parser": "generic_h3_p", "note": "头条搜索，整合字节系内容"},
    {"name": "Shenma", "url": "https://m.sm.cn/s?q={keyword}", "region": "cn", "parser": "generic_h3_p", "note": "神马移动搜索，UC浏览器默认"},
    {"name": "Google", "url": "https://www.google.com/search?q={keyword}{tbs}", "region": "global", "parser": "google", "note": "Google 主站，必要时用 google_hk 替代"},
    {"name": "Google HK", "url": "https://www.google.com.hk/search?q={keyword}{tbs}", "region": "global", "parser": "google", "note": "Google HK，国内可达时优先用此"},
    {"name": "DuckDuckGo", "url": "https://html.duckduckgo.com/html/?q={keyword}", "region": "global", "parser": "ddg", "note": "DDG HTML版，隐私搜索，无需JS"},
    {"name": "Yahoo", "url": "https://search.yahoo.com/search?p={keyword}", "region": "global", "parser": "generic_h3_p", "note": "Yahoo搜索，国际"},
    {"name": "Startpage", "url": "https://www.startpage.com/sp/search?query={keyword}", "region": "global", "parser": "generic_h3_p", "note": "Startpage，Google结果+隐私保护"},
    {"name": "Brave", "url": "https://search.brave.com/search?q={keyword}", "region": "global", "parser": "brave", "note": "Brave Search，独立索引"},
    {"name": "Ecosia", "url": "https://www.ecosia.org/search?q={keyword}", "region": "global", "parser": "generic_h3_p", "note": "Ecosia 环保搜索，盈利植树"},
    {"name": "Qwant", "url": "https://www.qwant.com/?q={keyword}", "region": "global", "parser": "generic_h3_p", "note": "Qwant 欧盟GDPR合规隐私搜索"},
    {"name": "WolframAlpha", "url": "https://www.wolframalpha.com/input?i={keyword}", "region": "global", "parser": "wolfram", "note": "WolframAlpha 知识计算/数据查询（非网页搜索）"}
  ]
}